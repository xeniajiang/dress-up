{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dress-up",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameRoom"
      ]
    }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "images": {
    "binding": "IMAGES"
  },
  "kv_namespaces": [
    {
      "binding": "VINEXT_KV_CACHE",
      "id": "5bfbb1d65415456ea32c231a204dd33c"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dress-up",
      "database_id": "bd20d299-b13d-4605-890d-f5153b6e7aaf",
      "migrations_dir": "drizzle"
    }
  ]
}
